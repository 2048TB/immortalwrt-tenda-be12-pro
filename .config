# Tenda BE12 Pro — 增量配置（基底见 diy.sh：上游 defconfig/low-mem-512m/mt7987-mt7992-be7200.config）
#
# 基底已包含：tenda_be12-pro 设备、MT7992 Wi-Fi 7 驱动栈（kmod-mt_wifi7 +
# kmod-mt_hwifi + kmod-mt7992 + warp + wifi-profile + l1profile 双频）、
# turboacc、eqos、argon 主题、zram 等。此处只放增量。

CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_tenda_be12-pro=y

# LuCI 与中文语言包
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mtwifi-cfg-zh-cn=y
CONFIG_PACKAGE_luci-i18n-turboacc-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-eqos-mtk-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# PassWall2（Xray 内核）
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y

CONFIG_CCACHE=y
